# ===== Ephata Store — biến môi trường mẫu =====
# Copy sang .env.local và điền giá trị thật. KHÔNG commit .env.local.

# --- URL công khai ---
NEXT_PUBLIC_SITE_URL=https://ephatastore.com
NEXT_PUBLIC_APP_GIAOLY_URL=https://app.giaoly.com.vn

# --- Supabase GIAOLY (nguồn Auth / Identity / Plan) ---
# Dùng để đăng nhập SSO và đọc gói (plan) của user. Store chỉ ĐỌC.
NEXT_PUBLIC_GIAOLY_SUPABASE_URL=
NEXT_PUBLIC_GIAOLY_SUPABASE_ANON_KEY=
# Secret ký JWT của project giaoly — để store verify token phía server.
GIAOLY_SUPABASE_JWT_SECRET=

# --- Supabase STORE (dữ liệu thương mại: sản phẩm, đơn hàng, sở hữu) ---
NEXT_PUBLIC_STORE_SUPABASE_URL=
NEXT_PUBLIC_STORE_SUPABASE_ANON_KEY=
STORE_SUPABASE_SERVICE_ROLE_KEY=

# --- Thanh toán PayOS (chốt sau ở bước checkout) ---
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
